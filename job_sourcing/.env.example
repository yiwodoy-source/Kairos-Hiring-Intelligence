# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/jobs_db
MONGODB_URI=mongodb://localhost:27017/jobs_db
REDIS_URL=redis://localhost:6379/0

# API Keys (Optional - for licensed sources)
JOOBLE_API_KEY=your_jooble_api_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
INDEED_PUBLISHER_ID=your_indeed_publisher_id

# Scraping Configuration
USER_AGENT=NexusHR-JobBot/1.0 (+https://nexushr.com/bot)
MAX_REQUESTS_PER_SECOND=1
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# Scheduler
SCRAPER_SCHEDULE_HOURS=6  # Run every 6 hours
