# n8n Workflow Configuration Template
# Copy this file and fill in your actual values

# ============================================
# WORKFLOW CONFIGURATION
# ============================================
SERPER_API_KEY=your_serper_api_key_here
COMPANY_NAME=Nexus HR AI
RECRUITER_NAME=Your Name Here

# ============================================
# GOOGLE SHEETS
# ============================================
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Candidates

# ============================================
# OPENAI API (Optional - if not using n8n free credits)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# SOCIAL MEDIA (Optional)
# ============================================
# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LinkedIn (OAuth - configure in n8n UI)
# Twitter (OAuth - configure in n8n UI)
# Facebook (OAuth - configure in n8n UI)

# ============================================
# EMAIL ENRICHMENT (Recommended)
# ============================================
# Choose one of these services to find candidate emails:

# Hunter.io
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo.io
APOLLO_API_KEY=your_apollo_api_key_here

# Snov.io
SNOV_API_KEY=your_snov_api_key_here

# ============================================
# N8N WEBHOOK (For integration with your app)
# ============================================
N8N_WEBHOOK_URL=http://localhost:5678/webhook/candidate-sourcing
N8N_API_KEY=your_n8n_api_key_here

# ============================================
# JOB DETAILS (Example - update per job posting)
# ============================================
JOB_ROLE=Senior Backend Engineer
JOB_SKILLS=Node.js, AWS, Python, Docker, Kubernetes
JOB_EXPERIENCE=5+
JOB_LOCATION=Remote
