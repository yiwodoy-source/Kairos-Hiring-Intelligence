# ─────────────────────────────────────────────────────────────────────────────
# NexusHR AI — Environment Variables
# Copy this file to .env and fill in all values before deploying.
# For Vercel: add each key in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Set in Vercel env vars for the frontend build.
# Points the browser at the deployed backend URL.
VITE_API_URL=https://your-app.vercel.app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Authentication ────────────────────────────────────────────────────────────
ADMIN_USER=admin
# Generate hash: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=
JWT_SECRET=         # 64+ random chars — openssl rand -hex 64

# ── Database — Supabase PostgreSQL ────────────────────────────────────────────
# Supabase → Project Settings → Database → URI connection string
# Leaving this empty falls back to SQLite (local dev only, not on Vercel)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── AI Providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Google OAuth (Gmail + Calendar) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
# Encryption key for stored refresh token — openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ── Candidate Sourcing ────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
SERPER_API_KEY=
# Optional: higher GitHub API rate limit (5000/hr vs 60/hr unauthenticated)
# GITHUB_TOKEN=
# Optional: higher Stack Overflow quota (10000/day vs 300/day)
# STACKOVERFLOW_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins.
# On Vercel set to your deployed URL: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3000

# ── OAuth callback (must match Google Cloud Console redirect URI) ─────────────
OAUTH_CALLBACK_URL=https://your-app.vercel.app/api/hr-agent/auth/callback

# ── Vercel Cron security ──────────────────────────────────────────────────────
# Random secret sent as Bearer token by Vercel Cron to /api/hr-agent/trigger/cycle
# Generate: openssl rand -hex 32
CRON_SECRET=
