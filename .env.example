# ── Frontend environment variables ───────────────────────────────────────────
# Copy to .env.local and fill in values.

# Backend API URL (required in production; leave empty in local dev)
# Local dev: leave empty — app auto-resolves to http://<hostname>:3001
# Production: set to your Railway / Render backend URL
VITE_API_URL=https://your-backend.railway.app
