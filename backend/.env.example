# ─────────────────────────────────────────────────────────────────────────────
# NexusHR AI — Backend Environment Variables
# Copy this file to .env and fill in your values before starting the server.
# [REQUIRED] vars must be set. Everything else has a working default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:5173
# Public URL of this backend (used in unsubscribe links and OAuth redirects)
APP_URL=http://localhost:3001
LOG_LEVEL=info                  # debug | info | warn | error

# ── Authentication ────────────────────────────────────────────────────────────
# [REQUIRED in production] Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: pre-hashed bcrypt password (takes precedence over ADMIN_PASSWORD)
# ADMIN_PASSWORD_HASH=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use local SQLite. Set for Supabase/PostgreSQL in production.
DATABASE_URL=
# Example: DATABASE_URL=postgresql://user:pass@db.supabase.co:5432/postgres

# ── Google OAuth + Workspace ──────────────────────────────────────────────────
# [REQUIRED for Gmail/Drive/Calendar]
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com
# Redirect URI must be: {APP_URL}/api/hr-agent/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3001/api/hr-agent/auth/callback

# Refresh token is stored encrypted in the DB after the first OAuth flow.
# Optionally set here for first-boot seeding — migrated to DB automatically.
GOOGLE_REFRESH_TOKEN=

# Gmail labels (auto-created if missing)
GMAIL_APPLICATION_LABEL=HR-Applications
GMAIL_PROCESSED_LABEL=HR-Processed

# Google Drive — leave empty to skip CV uploads
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=HR-CVs

# Google Sheets — leave empty to skip spreadsheet export
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Candidates

# Google Calendar — for interview scheduling
GOOGLE_CALENDAR_ID=primary
INTERVIEW_TIMEZONE=Asia/Kolkata
INTERVIEW_LOOKAHEAD_DAYS=7
INTERVIEW_WORKDAY_START_HOUR=9
INTERVIEW_WORKDAY_END_HOUR=18
INTERVIEW_SLOT_MINUTES=45

# ── AI Services ───────────────────────────────────────────────────────────────
# At least one key needed for CV analysis.
# Priority order: OpenRouter → Gemini → keyword fallback

# OpenRouter (recommended) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini fallback — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — used by OpenClaw auto-direct transport
OPENAI_API_KEY=

# ── OpenClaw (AI Workflow Orchestrator) ───────────────────────────────────────
OPENCLAW_ENABLED=false
# Transport: http | ollama-direct | openrouter-direct | openai-direct | gemini-direct | auto-direct
OPENCLAW_TRANSPORT=auto-direct
OPENCLAW_BASE_URL=http://127.0.0.1:4010
OPENCLAW_MODEL=openclaw
OPENCLAW_AUTH_TOKEN=

# Per-transport model overrides
OPENCLAW_OPENAI_MODEL=gpt-4.1-mini
OPENCLAW_OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENCLAW_GEMINI_MODEL=gemini-2.0-flash
OPENCLAW_OLLAMA_MODEL=gemma4:e4b
OPENCLAW_OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENCLAW_OPENAI_BASE_URL=https://api.openai.com/v1
OPENCLAW_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Candidate Sourcing ────────────────────────────────────────────────────────
# ScrapeGraphAI — https://scrapegraphai.com
SCRAPEGRAPH_API_KEY=
SCRAPEGRAPH_BASE_URL=https://api.scrapegraphai.com/v1

# Firecrawl — https://firecrawl.dev
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Merge.dev ATS — https://merge.dev
MERGE_API_KEY=
MERGE_ACCOUNT_TOKEN=
MERGE_BASE_URL=https://api.merge.dev/api/ats/v1

# Serper (Google search for sourcing flows)
SERPER_API_KEY=

# ── HR Agent Scheduler ────────────────────────────────────────────────────────
HR_AGENT_AUTO_START=false
CRON_INTERVAL=* * * * *
# Max CVs to process per cycle (prevents AI/Gmail quota bursts). Remainder deferred to next tick.
MAX_CVS_PER_CYCLE=10
# Delay in ms between processing each CV within a cycle (throttles API calls)
CV_PROCESSING_DELAY_MS=1500
# Max Gmail messages fetched per cycle across both label + unread sources (hard cap: 50)
GMAIL_FETCH_LIMIT=15

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_AUTO_ACKNOWLEDGE=false
WHATSAPP_REQUIRE_OPT_IN=true
WHATSAPP_DEFAULT_COUNTRY_CODE=91

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Security (advanced) ───────────────────────────────────────────────────────
# Separate HMAC secret for unsubscribe tokens.
# Set if you rotate JWT_SECRET and want old unsubscribe links to keep working.
# UNSUBSCRIBE_SECRET=
