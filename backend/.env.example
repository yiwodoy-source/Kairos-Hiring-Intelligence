PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=replace_with_a_strong_secret
ADMIN_USERNAME=mayur
ADMIN_PASSWORD=replace_with_a_secure_password
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash
HR_AGENT_AUTO_START=true

# Google OAuth / Workspace automation
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
OAUTH_CALLBACK_URL=http://localhost:3001/api/hr-agent/auth/callback
GOOGLE_DRIVE_FOLDER_NAME=NexusHR Candidates
GOOGLE_SHEET_TAB=Candidates
GOOGLE_CALENDAR_ID=primary
INTERVIEW_TIMEZONE=Asia/Kolkata
INTERVIEW_SLOT_MINUTES=30
INTERVIEW_LOOKAHEAD_DAYS=5
INTERVIEW_WORKDAY_START_HOUR=10
INTERVIEW_WORKDAY_END_HOUR=18

# Gmail automation labels
GMAIL_APPLICATION_LABEL=NexusHR/Application
GMAIL_PROCESSED_LABEL=NexusHR/Processed

# OpenClaw orchestration gateway
OPENCLAW_ENABLED=false
OPENCLAW_TRANSPORT=http
OPENCLAW_BASE_URL=http://127.0.0.1:4010
OPENCLAW_AUTH_TOKEN=your_openclaw_gateway_token
OPENCLAW_MODEL=openclaw
OPENCLAW_OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENCLAW_OLLAMA_MODEL=qwen3:8b
OPENCLAW_OPENAI_BASE_URL=https://api.openai.com/v1
OPENCLAW_OPENAI_MODEL=gpt-4.1-mini
OPENCLAW_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENCLAW_OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENCLAW_GEMINI_MODEL=gemini-2.0-flash

# Optional sourcing / ATS integrations
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

MERGE_API_KEY=your_merge_api_key
MERGE_ACCOUNT_TOKEN=your_merge_linked_account_token
MERGE_BASE_URL=https://api.merge.dev/api/ats/v1

SCRAPEGRAPH_API_KEY=sgai-your-scrapegraph-api-key
SCRAPEGRAPH_BASE_URL=https://v2-api.scrapegraphai.com

# Optional WhatsApp outreach via Twilio
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_REQUIRE_OPT_IN=true
WHATSAPP_AUTO_ACKNOWLEDGE=false
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
